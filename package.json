{
  "name": "sample-x402-content-monetization-with-cloudfront-and-waf",
  "version": "0.1.0",
  "description": "One-click deployable AWS solution for x402 content monetization at the edge using Amazon CloudFront, AWS Lambda@Edge, and AWS WAF",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:editor": "cd editor && npm ci && npm run build",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:property": "jest --testPathPattern=tests/property",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "x402",
    "aws",
    "cloudfront",
    "lambda-edge",
    "waf",
    "payment",
    "monetization"
  ],
  "license": "MIT-0",
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1105.0",
    "@aws-sdk/client-secrets-manager": "^3.1105.0",
    "@aws-sdk/client-ssm": "^3.1105.0",
    "@aws-sdk/client-wafv2": "^3.1105.0",
    "@x402/core": "^2.21.0",
    "@x402/evm": "^2.21.0",
    "jose": "^6.2.8"
  },
  "devDependencies": {
    "@coinbase/cdp-sdk": "^1.55.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@x402/fetch": "^2.21.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "fast-check": "^4.9.0",
    "jest": "^30.4.2",
    "js-yaml": "^5.2.3",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "axios": "^1.19.0"
  }
}
